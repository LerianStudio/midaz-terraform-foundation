# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Local workspace state. examples/aws/bootstrap creates its own backend, so it
# runs on LOCAL state with one workspace per environment:
# terraform.tfstate.d/<env>/terraform.tfstate. Already matched by *.tfstate
# above; kept explicit so the directory is never staged by mistake.
terraform.tfstate.d/

# Generated backend configuration written by examples/aws/bootstrap. Contains the
# client's AWS account id in the bucket name, so it stays out of this repository.
# examples/aws/backend/README.md and .gitkeep remain tracked.
examples/aws/backend/*.hcl

# tfplan files
*.tfplan
tfplan

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfvars files that are safe to be checked in
!example.tfvars

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
node_modules
package-lock.json

# Plans and documentation (local only - root level)
/docs/

# Beads issue tracker (local only)
.beads/
