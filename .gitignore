# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Local workspace state. examples/aws/bootstrap creates its own backend, so it
# runs on LOCAL state with one workspace per environment:
# terraform.tfstate.d/<env>/terraform.tfstate. Already matched by *.tfstate
# above; kept explicit so the directory is never staged by mistake.
terraform.tfstate.d/

# Generated backend configuration written by examples/aws/bootstrap. Contains the
# client's AWS account id in the bucket name, so it stays out of this repository.
# examples/aws/backend/README.md and .gitkeep remain tracked.
examples/aws/backend/*.hcl

# Environment -> AWS account mapping consumed by deploy.sh. Carries the client's
# account ids and profile names, for the same reason the backend config above is
# excluded. examples/aws/environments.conf.example remains tracked and is the
# template operators copy.
examples/aws/environments.conf

# tfplan files. Terraform saved plans are ZIP archives that embed the full state
# and config, including account ids and any value marked sensitive - they must
# never be committed. The bare `tfplan` and `*.tfplan` patterns below missed
# `tfplan.dev` / `tfplan.stg`, which is exactly how two of them got committed, so
# `tfplan*` catches every suffix.
*.tfplan
tfplan
tfplan*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tfvars files that are safe to be checked in
!example.tfvars

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
node_modules
package-lock.json

# Plans and documentation (local only - root level)
/docs/

# Beads issue tracker (local only)
.beads/

# Go build artifacts of cmd/lerian-infra. Every pattern here is root-anchored or
# extension-based on purpose: an unanchored `bin` would also swallow any bin/
# directory that appears under examples/, and this repository's Terraform roots
# are not off-limits to one.
#
# `go build ./cmd/lerian-infra` with no -o writes ./lerian-infra; `make build`
# writes bin/lerian-infra. Both are listed because both are things people run.
/bin/
/lerian-infra

# `go test -c` output, and the coverage files the Makefile and CI can produce.
*.test
coverage.out
coverage.html
