################################################################################
# infra-base/vpc — prd
#
# One NAT Gateway per AZ, long forensic retention on flow logs, and kms plus sts
# added to the interface endpoints so the Secrets Manager decrypt path and the
# IRSA token exchange stay inside the VPC instead of billing NAT data processing.
#
# Copy to prd.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "lerian"
environment = "prd"

# Network
vpc_cidr           = "10.52.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b", "us-east-1c"]

# NAT: one per AZ. An AZ outage takes down that AZ's egress only, and no
# cross-AZ data charge is paid on the normal path.
enable_nat_gateway     = true
single_nat_gateway     = false
one_nat_gateway_per_az = true

# DNS
enable_dns_hostnames = true
enable_dns_support   = true

# Flow logs: 90 days is the shortest window that survives an incident review.
# Raise to 365 where a regulator asks for a year of network evidence.
flow_logs_enabled        = true
flow_logs_retention_days = 90

# Endpoints. Five interface endpoints across three AZs is roughly USD 110/month
# before data; kms and sts earn that back on NAT data processing at production
# request volume, and they remove the internet from the credential path.
vpc_endpoint_enabled        = true
interface_endpoint_services = ["rds", "secretsmanager", "elasticache", "kms", "sts"]
enable_s3_gateway_endpoint  = true

# cluster_name derives to lerian-prd-eks.

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform"
}
