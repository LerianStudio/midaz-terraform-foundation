################################################################################
# infra-base/eks — stg
#
# Production-shaped but smaller: private endpoint plus a narrow public allowlist,
# ARM nodes, load balancer controller on. Cluster name: lerian-stg-eks.
################################################################################

region      = "us-east-1"
product     = "lerian"
environment = "stg"

# Control plane
cluster_version = "1.32"

# MUST BE EDITED BEFORE APPLYING. The placeholder is not a valid CIDR on purpose,
# so `terraform plan` stops with an actionable error rather than failing in AWS
# mid-apply (the RFC 5737 documentation ranges that used to sit here are refused
# by publicAccessCidrs) or quietly leaving the Kubernetes API open. Find the
# office egress address with `curl -s https://checkip.amazonaws.com` and use
# "<that address>/32". Keep this list narrower than dev's.
cluster_endpoint_public_access  = true
cluster_endpoint_private_access = true
allowed_api_access_cidrs = [
  "<PUT-YOUR-OFFICE-EGRESS-IP-HERE>/32"
]

enable_cluster_creator_admin_permissions = true

cloudwatch_log_group_retention_in_days = 30

# One ARM general pool spread across the private subnets of every AZ.
node_groups = {
  general = {
    instance_types = ["c7g.large"]
    ami_type       = "AL2_ARM_64"
    capacity_type  = "ON_DEMAND"
    min_size       = 2
    max_size       = 6
    desired_size   = 3
    disk_size      = 50
  }
}

create_autoscaler_role               = true
create_load_balancer_controller_role = true
create_external_dns_role             = false
create_cert_manager_role             = false

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-stg"
}
