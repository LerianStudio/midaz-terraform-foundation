################################################################################
# infra-base/eks — prd
#
# Private API endpoint only, multi-AZ nodes (the infra-base/vpc stack spreads the
# private subnets across three AZs, and the node groups follow), a general pool
# plus a tainted pool for heavy workloads. Cluster name: lerian-prd-eks.
#
# With cluster_endpoint_public_access = false the API is only reachable from
# inside the VPC: use a bastion, a VPN, or self-hosted CI runners in the VPC.
################################################################################

region      = "us-east-1"
product     = "lerian"
environment = "prd"

# Control plane
cluster_version = "1.32"

# The empty list is correct here, and ONLY because the public endpoint is off:
# allowed_api_access_cidrs governs the public endpoint alone, so with
# cluster_endpoint_public_access = false it has nothing to filter. Do not copy
# this pair into dev/stg - there, public access is on and an empty list makes AWS
# fall back to 0.0.0.0/0.
cluster_endpoint_public_access  = false
cluster_endpoint_private_access = true
allowed_api_access_cidrs        = []

enable_cluster_creator_admin_permissions = true

cloudwatch_log_group_retention_in_days = 90

# Two pools: general workloads, plus a dedicated tainted pool so only workloads
# that tolerate it (ledger transaction processing, batch) land on the big nodes.
node_groups = {
  general = {
    instance_types = ["c7g.xlarge"]
    ami_type       = "AL2_ARM_64"
    capacity_type  = "ON_DEMAND"
    min_size       = 3
    max_size       = 12
    desired_size   = 4
    disk_size      = 100
  }

  heavy = {
    instance_types = ["c7g.2xlarge"]
    ami_type       = "AL2_ARM_64"
    capacity_type  = "ON_DEMAND"
    min_size       = 2
    max_size       = 8
    desired_size   = 2
    disk_size      = 150

    labels = {
      workload = "heavy"
    }

    taints = {
      dedicated = {
        key    = "workload"
        value  = "heavy"
        effect = "NO_SCHEDULE"
      }
    }
  }
}

create_autoscaler_role               = true
create_load_balancer_controller_role = true
create_external_dns_role             = true
create_cert_manager_role             = true

# PUBLIC ingress DNS only. This repository provisions no private hosted zone —
# the datastores hand out raw AWS endpoints, because a private CNAME breaks TLS
# hostname verification. The zone here is whichever public zone the client owns
# and wants ExternalDNS / cert-manager to write into.
#
# Narrow the wildcard to that zone's ID before prd, e.g.
# ["arn:aws:route53:::hostedzone/Z0123456789ABCDEFGHIJ"].
external_dns_hosted_zone_arns = ["arn:aws:route53:::hostedzone/*"]
cert_manager_hosted_zone_arns = ["arn:aws:route53:::hostedzone/*"]

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
  Compliance = "bacen"
}
