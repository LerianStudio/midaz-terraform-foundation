################################################################################
# products/midaz/rabbitmq — stg
#
# CLUSTER_MULTI_AZ on mq.m5.large: the first topology that exercises a real
# cluster. Three broker nodes instead of dev's one, on a larger type than dev's
# mq.m7g.medium — this is the step where the cost of the broker becomes visible.
#
# mq.m5.large is a sizing decision, not a floor: for RabbitMQ the deployment mode
# does not constrain the instance type, and mq.m7g.medium clusters perfectly well
# if stg only needs to rehearse the topology.
#
# Copy to stg.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "midaz"
environment = "stg"

mode = "dedicated"

# If you switch to mode = "shared", shared_broker_name is MANDATORY here. The
# products/shared-resources/rabbitmq stg tfvars deploy the shared broker as
# CLUSTER_MULTI_AZ, and
# the derived default assumes -single:
#   shared_broker_name = "shared-stg-rabbitmq-cluster"

# vpc_name         is derived -> lerian-stg-vpc
# eks_cluster_name is derived -> lerian-stg-eks

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Ports
################################################################################

port                   = 5671
console_port           = 443
enable_console_ingress = true

################################################################################
# Broker — CLUSTER_MULTI_AZ on mq.m5.large
#
# append_deployment_suffix stays true: it is what makes the SINGLE_INSTANCE ->
# CLUSTER_MULTI_AZ migration a side-by-side procedure (the -single and -cluster
# brokers coexist) rather than a destroy-and-recreate. See the module's
# docs/UPGRADE-GUIDE.md.
################################################################################

broker_deployment_mode   = "CLUSTER_MULTI_AZ"
append_deployment_suffix = true
host_instance_type       = "mq.m5.large"
engine_version           = "3.13"
mq_admin_user            = "rabbitmqadmin"

auto_minor_version_upgrade = true
apply_immediately          = false
enable_general_logs        = true

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-stg"
}
