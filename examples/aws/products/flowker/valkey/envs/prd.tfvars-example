################################################################################
# products/flowker/valkey — prd
#
# INFERRED COMPOSITION — see ../../README.md. These sizes are the standard Lerian
# prd shape, not a value validated against flowker's real workload.
#
# Three cache clusters across three AZs with automatic failover, daily snapshots
# retained for a week.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "flowker"
environment = "prd"

mode = "dedicated"

# vpc_name         is derived -> lerian-prd-vpc
# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine and sizing — cache.m7g.large, three cache clusters, Multi-AZ
#
# If flowker uses Valkey for distributed LOCKS rather than only for caching, node
# count and failover behaviour stop being a performance question and become a
# correctness one. That is exactly the kind of thing the missing chart would have
# told us — confirm it with the service owner before the first prd apply.
################################################################################

engine_version         = "7.2"
parameter_group_family = "valkey7"
port                   = 6379

node_type                  = "cache.m7g.large"
num_cache_clusters         = 3
automatic_failover_enabled = true
multi_az_enabled           = true
snapshot_retention_limit   = 7

################################################################################
# Security — the KNOWN GAP, and here it is unassessable rather than merely open
#
# Everywhere else in this repository transit_encryption_mode stays "preferred"
# and auth_token_enabled stays false because a NAMED chart lacks a TLS/AUTH
# client configuration. Here there is no chart to name. The auth token IS
# generated and stored at flowker-prd-valkey/auth-token regardless, so turning
# both on later is a tfvars change plus a chart change, not a rebuild. Until
# then the cache is protected by the security group and the private subnets
# alone. Raise it with the service owner; do not leave it here by default.
################################################################################

transit_encryption_enabled = true
transit_encryption_mode    = "preferred"
auth_token_enabled         = false

maintenance_window = "mon:00:00-mon:03:00"
apply_immediately  = false

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
