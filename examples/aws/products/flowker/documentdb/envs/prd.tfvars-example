################################################################################
# products/flowker/documentdb — prd
#
# INFERRED COMPOSITION, AND THAT MATTERS MOST HERE.
#
# flowker has no readable Helm chart in this monorepo, so this file sizes a
# production cluster for a workload nobody in this repository can describe. The
# numbers below are the standard Lerian prd shape — three instances across three
# AZs, deletion protection on, audit exported — and they are a STARTING POINT.
#
# Before a first prd apply, get the workload profile from the team that owns
# flowker: orchestration engines are write-heavy in bursts, which is a different
# instance class question from a read-heavy console.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "flowker"
environment = "prd"

mode = "dedicated"

# vpc_name         is derived -> lerian-prd-vpc
# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# TLS — unassessable, not merely disabled
#
# Everywhere else in this repository, documentdb_tls = "disabled" comes with a
# named blocker (a CA bundle the chart has to mount). Here there is no chart to
# read, so the client side cannot be assessed at all. Raise it with the service
# owner rather than flipping it and finding out in production.
################################################################################

documentdb_tls = "disabled"

################################################################################
# Engine and sizing — db.r6g.large, three instances
################################################################################

master_username = "docdbadmin"
port            = 27017

instance_class         = "db.r6g.large"
instances_count        = 3
parameter_group_family = "docdb5.0"

backup_retention_period = 14
preferred_backup_window = "07:00-09:00"
skip_final_snapshot     = false
deletion_protection     = true
apply_immediately       = false

enabled_cloudwatch_logs_exports = ["audit", "profiler"]

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
