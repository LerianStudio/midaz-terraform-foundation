################################################################################
# products/plugin-br-pix-direct-jd/postgres — dev
#
# Absolute minimum sizing. db.t4g.micro with 20 GB is roughly USD 15/month.
# PostgreSQL is the only datastore this product needs — the chart declares no
# Redis, no AMQP broker, no Kafka and no Mongo. See ../README.md.
#
# Copy to dev.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "plugin-br-pix-direct-jd"
environment = "dev"

# "dedicated" creates plugin-br-pix-direct-jd-dev-postgres. Switch to "shared" to
# consume the instance owned by products/shared-resources/postgres instead; this
# stack then creates nothing and every sizing value below is ignored.
mode = "dedicated"

# vpc_name         is derived -> lerian-dev-vpc        (infra-base/vpc)
# eks_cluster_name is derived -> lerian-dev-eks        (infra-base/eks)

################################################################################
# Ingress
#
# One allow list covers BOTH workloads of this chart — the pix Deployment and the
# CronJob — because they run on the same EKS nodes.
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine
#
# engine_version stays MAJOR-only. Pinning "16.3" is what broke a real apply:
# AWS retired that minor and every plan afterwards failed with
# "Cannot find version 16.3 for postgres".
#
# database_name matches the chart default. This chart has NO bootstrap Job — with
# the bundled Bitnami subchart the database came from the container entrypoint,
# and with external RDS nothing else would create it, so Terraform creating it
# here is what makes the external path work at all.
#
# username is the RDS MASTER. The chart's DATABASE_USER default is "pix" and
# nothing in the chart creates that role against an external instance;
# helm_values emits the master.
################################################################################

engine_version       = "16"
family               = "postgres16"
major_engine_version = "16"
database_name        = "pix"
username             = "postgres"

################################################################################
# Sizing — db.t4g.micro (~USD 15/month)
#
# Performance Insights MUST stay false: AWS does not offer it on db.t4g.micro,
# and the module rejects the combination with a plan-time precondition.
################################################################################

instance_class        = "db.t4g.micro"
allocated_storage     = 20
max_allocated_storage = 50
multi_az              = false

backup_retention_period = 1
skip_final_snapshot     = true
deletion_protection     = false

performance_insights_enabled = false
monitoring_interval          = 0
create_monitoring_role       = false

enabled_cloudwatch_logs_exports = ["postgresql"]

# There is no create_read_replica variable in this root, on purpose: the chart
# defines no replica environment variable to point one at. See main.tf.

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-dev"
}
