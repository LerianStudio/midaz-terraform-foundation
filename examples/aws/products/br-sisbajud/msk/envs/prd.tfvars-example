################################################################################
# products/br-sisbajud/msk — prd
#
# Three brokers, one per Type=database subnet, replication factor 3 so a single
# broker loss costs no partitions. Roughly USD 630/month at 500 GB per broker.
#
# THIS IS THE ENVIRONMENT WHERE mode = "dedicated" CAN ACTUALLY BE JUSTIFIED, and
# the justification is regulatory isolation rather than cost or throughput. A
# shared Kafka cluster is ONE topic namespace, ONE set of ACLs and ONE retention
# budget for every product pointed at it. br-sisbajud carries judicial asset
# blocking and unblocking ordered through BACEN SISBAJUD — block_account.created,
# kek.rotated and the balance events behind them. If the deployment has to be
# able to state that no other workload can read or replay those events, that is
# the argument, and this directory is how it is met.
#
# Note what the chart does NOT say: it requires a broker (STREAMING_ENABLED
# defaults to "true", STREAMING_BROKERS is REQUIRED and empty fails closed at
# boot), but nowhere does it require a DEDICATED broker. Record the isolation
# decision explicitly rather than inheriting it from this file.
#
# THESE SIZES ARE A STARTING POINT, NOT A RECOMMENDATION. Selecting instance
# types is the client's responsibility; see the Instance Types Disclaimer in the
# repository README.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "br-sisbajud"
environment = "prd"

mode = "dedicated"

# vpc_name         is derived -> lerian-prd-vpc
# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Ingress — the tight posture
#
# allow_private_subnet_cidr_ingress = false: security-group-only ingress, which
# requires infra-base/eks to exist first. Before the first prd apply, confirm
# check "eks_node_security_group_resolved" does NOT warn — with both this and
# the allow lists empty, the module's check "ingress_is_reachable" fires and the
# cluster accepts no connections.
################################################################################

allow_private_subnet_cidr_ingress      = false
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

# Add the VPN or bastion security group here if operators need direct access.
allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Cluster — kafka.m7g.large x 3, TIERED storage
#
# TIERED moves cold segments off the broker EBS volume and is the lever to pull
# when retention grows. It is rejected by the kafka.t3.* family, which is why
# dev cannot use it.
#
# Retention matters more than usual here: SISBAJUD block/unblock events are the
# audit trail of a judicial order. Set the per-topic retention deliberately in
# the chart's topics.retentionMs rather than inheriting the broker default.
################################################################################

kafka_version          = "3.6.0"
number_of_broker_nodes = 3
broker_instance_type   = "kafka.m7g.large"
broker_ebs_volume_size = 500
storage_mode           = "TIERED"

enable_storage_autoscaling       = true
storage_autoscaling_max_capacity = 2000

################################################################################
# Security
################################################################################

encryption_in_transit_client_broker = "TLS"

enable_sasl_scram      = true
scram_username         = "lerian"
enable_unauthenticated = false

################################################################################
# Kafka configuration
#
# Replication factor 3 across three brokers: a single broker loss costs no
# partitions.
#
# THIS IS THE BROKER DEFAULT ONLY. It applies to topics created without an
# explicit factor. The chart's PreSync rpk Job passes one from
# topics.replicationFactor, which DEFAULTS TO 1 (values.yaml:176). Set it to 3
# in the prd release values or all six SISBAJUD topics live on one broker,
# regardless of what this line says.
################################################################################

auto_create_topics_enable  = false
default_replication_factor = 3

################################################################################
# Observability
################################################################################

enhanced_monitoring                    = "PER_BROKER"
cloudwatch_logs_enabled                = true
cloudwatch_log_group_retention_in_days = 90

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
