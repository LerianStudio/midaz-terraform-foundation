################################################################################
# products/br-consignado-gw/secrets — prd
#
# Costs nothing: one IAM role and one IAM policy.
#
# THE ONE VALUE THAT IS PERMANENT. secret_path_prefixes carries "production", not
# "prd", and it can never change afterwards. The gateway re-parses the stored
# credential reference on read and demands exact scope equality, so every Dataprev
# credential written under one environment name becomes unreadable the day the name
# changes. Environment vocabulary in this repository is dev|stg|prd; the vault
# vocabulary of the application is "production". Both accounts of this estate —
# homologation and production — run ENV_NAME=production, so both use this value.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "sa-east-1"
product     = "br-consignado-gw"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Identity
#
# Must equal the ServiceAccount the gateway release actually creates. The :sub
# condition on the trust policy admits this exact namespace:name and nothing else,
# so a namespace rename here is a silent AccessDenied on every vault call.
################################################################################

service_account = "consignado:br-consignado-gw"

################################################################################
# Vault scope
#
# Two prefixes, both under the application's ENV_NAME:
#
#   .../external/{dataprev-cert|dataprev-oauth}/credentials/versions/{uuid}
#       the custody credential itself, written by the TENANT through the gateway's
#       own API, never by an operator and never by Terraform.
#   .../m2m/{targetService}/credentials
#       the machine-to-machine credential the tenant-manager provisions during
#       onboarding, which is how the gateway authenticates to the rest of the
#       estate.
#
# One prefix covers both, because both live under tenants/production/.
################################################################################

secret_path_prefixes = ["tenants/production/"]

read_actions = [
  "secretsmanager:GetSecretValue",
  "secretsmanager:DescribeSecret",
]

# CreateSecret stages a new immutable version; DeleteSecret rolls a failed staging
# back. PutSecretValue is refused by a variable validation, not merely omitted.
write_actions = [
  "secretsmanager:CreateSecret",
  "secretsmanager:DeleteSecret",
]

# The gateway reads by exact reference and enumerates nothing, and ListSecrets is
# the one action AWS will not scope to a resource.
allow_list_secrets = false

# Empty while the vault uses the AWS-managed key. The gateway makes no explicit KMS
# call anywhere; the day a CMK backs these secrets, CreateSecret fails on the
# encrypt until the key ARN appears here.
kms_key_arns = []

extra_tags = {
  Owner      = "consignado"
  CostCenter = "consignado-prd"
  Compliance = "bacen"
}
