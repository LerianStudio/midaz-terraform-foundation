################################################################################
# products/fetcher/s3 — prd
#
# Raw extracted source data. This is the shortest-lived bucket of the three
# products: extraction output is reprocessable from the source system, so it
# is cheaper to expire it than to archive it.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "fetcher"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks   (infra-base/eks)

################################################################################
# IRSA
#
# irsa_enabled = true resolves the cluster OIDC provider from the derived cluster
# name and creates the role. Unlike the datastore roots, this one CANNOT be
# applied before infra-base/eks exists: the OIDC lookup is a singular data source
# and fails the plan.
#
# The object storage keys are on the WORKER in this chart, so it is the worker's
# ServiceAccount that needs the eks.amazonaws.com/role-arn annotation. Check the
# rendered name before the first apply — a mismatch fails at runtime with
# AccessDenied, not at apply time.
#
# Set oidc_provider_arn explicitly to skip both lookups.
################################################################################

irsa_enabled    = true
service_account = "fetcher:fetcher-worker"

################################################################################
# Buckets
#
# No Glacier tier: an object that lives 180 days never reaches the 90-day
# minimum-duration break-even for Glacier, so the transition would cost more than
# it saves. The module validates the ordering (expiration after every
# transition) at plan time.
#
# force_destroy stays false.
################################################################################

buckets = {
  "external-data" = {
    versioning_enabled = true
    force_destroy      = false

    transition_ia_days         = 15
    expiration_days            = 180
    noncurrent_expiration_days = 30
  }
}

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
