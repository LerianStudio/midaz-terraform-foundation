################################################################################
# products/fetcher/documentdb — dev
#
# DocumentDB has no cheap corner: db.t3.medium is the SMALLEST class the
# service offers (there is no micro and no small), so one instance is roughly
# USD 60/month. If that is not acceptable for an ephemeral environment, set
# mode = "shared" and consume the cluster owned by
# products/shared-resources/documentdb instead of running a second one.
#
# Copy to dev.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "fetcher"
environment = "dev"

mode = "dedicated"

# vpc_name         is derived -> lerian-dev-vpc   (infra-base/vpc)
# eks_cluster_name is derived -> lerian-dev-eks   (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine and sizing — db.t3.medium, one instance (~USD 60/month)
#
# instance_class MUST be db.t3.medium or larger. The RDS burstable micro/small
# range does not exist for DocumentDB, and the module rejects those values with a
# plan-time precondition rather than five minutes into the apply.
################################################################################

master_username = "docdbadmin"
port            = 27017

instance_class         = "db.t3.medium"
instances_count        = 1
parameter_group_family = "docdb5.0"

documentdb_tls = "disabled"

backup_retention_period = 1
skip_final_snapshot     = true
deletion_protection     = false

enabled_cloudwatch_logs_exports = []

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-dev"
}
