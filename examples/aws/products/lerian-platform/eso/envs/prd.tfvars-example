################################################################################
# products/lerian-platform/eso — prd
#
# Costs nothing: one IAM role and one IAM policy.
#
# THIS IS THE STACK THAT MAKES EVERY OTHER CREDENTIAL USABLE. Every datastore root
# in this repository generates a strong password and writes it to Secrets Manager,
# and none of them delivers it to a pod. Apply the whole estate without this and
# every workload boots without its database password.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "sa-east-1"
product     = "lerian-platform"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks

# The external-secrets chart default. Change it here if the release overrides
# serviceAccount.name — the :sub condition admits nothing else.
service_account = "external-secrets:external-secrets"

################################################################################
# Scope
#
# Both vault roots, read only. ESO projects for every workload, so a per-product
# scope defeats it — and the asymmetry that matters is the WRITE side: this role
# has no CreateSecret, no PutSecretValue and no DeleteSecret, so a compromise of
# the operator reads credentials but cannot destroy them.
################################################################################

secret_path_prefixes = [
  # --- application secrets, written at runtime by tenant-manager and the gateway
  "tenants/",
  "clusters/",

  # --- installation secrets: not a tenant's, not a datastore's, not written by
  # anything automated. The streaming-hub KEK lives here
  # (installation/production/streaming-hub/kek), generated by the operator at the
  # installation-secrets step of the helmfile phase.
  #
  # GRANTED NOW, BEFORE THE SECRET EXISTS, ON PURPOSE. A prefix grant over an empty
  # namespace costs nothing, and the alternative — "remember to add this later" —
  # fails exactly the way the missing datastore family did: the ExternalSecret sits
  # in SecretSyncedError, the hub boots healthy and REFUSES TO SIGN, and the first
  # anybody hears of it is a webhook delivered without an HMAC.
  "installation/",

  # --- datastore secrets, written at APPLY TIME by this repository's own modules.
  # A list without these reads every application secret and NOT ONE DATABASE
  # PASSWORD, and the symptom is SecretSyncedError on exactly the ExternalSecrets
  # the estate cannot boot without. One line per product with a datastore root;
  # adding a product means adding a line here, and forgetting is the failure above.
  #
  #   {product}-{env}-postgres/password      _modules/postgres-rds/main.tf:255
  #   {product}-{env}-valkey/auth-token      _modules/valkey-elasticache/main.tf:226
  #   {product}-{env}-docdb/password         _modules/mongodb-documentdb/main.tf:177
  #   AmazonMSK_{name}                       _modules/streaming-msk/main.tf:88-92
  "plugin-access-manager-prd-",
  "tenant-manager-prd-",
  "br-consignado-gw-prd-",
  "streaming-hub-prd-",
  "shared-prd-",
  "AmazonMSK_",
]

read_actions = [
  "secretsmanager:GetSecretValue",
  "secretsmanager:DescribeSecret",
]

################################################################################
# The hole carved back out of the broad Allow
#
# tenants/ above covers the Dataprev custody path. Without this Deny, anyone able
# to create an ExternalSecret in any namespace could project a tenant's Dataprev
# credential into a Secret they read — the operator is read-only, which stops it
# destroying credentials and does nothing about exfiltrating one.
#
# The gateway reads its own custody store with its OWN role, so ESO loses nothing.
#
# Four segments before "external" on purpose: it matches
# tenants/{env}/{org}/{app}/external/... and not tenants/{env}/{tid}/{module}/kafka,
# including the case of a module literally named "external".
################################################################################

deny_secret_path_patterns = ["tenants/*/*/*/external/"]

deny_actions = [
  "secretsmanager:GetSecretValue",
  "secretsmanager:BatchGetSecretValue",
  "secretsmanager:DescribeSecret",
]

allow_list_secrets = true

################################################################################
# CMK — REQUIRED BEFORE THE MSK SASL PASSWORD CAN BE PROJECTED
#
# AWS refuses an AWS-managed key on a secret associated with an MSK cluster, so the
# MSK module creates its own CMK. Without kms:Decrypt on it, the ExternalSecret
# carrying STREAMING_KAFKA_SASL_PASSWORD sits in SecretSyncedError while every other
# secret projects normally — and both br-consignado-gw and streaming-hub refuse to
# talk to Kafka in a managed deployment without SASL.
#
# FILL THIS IN after products/shared-resources/msk has been applied:
#
#   terraform -chdir=examples/aws/products/shared-resources/msk output -raw scram_kms_key_arn
#
# The placeholder below is intentional and BREAKS THE PLAN: lerian-infra aborts on
# any "<...>" token outside a comment. Replace it, or delete the entry entirely if
# MSK has not been applied yet and the Kafka projection can wait.
#
# THIS IS NOT THE FIRST THING TO SUSPECT ON A SecretSyncedError. A path missing from
# secret_path_prefixes produces the identical symptom and is far more common. Check
# the prefixes before the key.
################################################################################

kms_key_arns = ["<MSK-SCRAM-CMK-ARN>"]

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
