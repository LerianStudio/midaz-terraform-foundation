################################################################################
# products/reporter/rabbitmq — prd
#
# CLUSTER_MULTI_AZ on mq.m5.large. AmazonMQ spreads a RabbitMQ cluster across
# three AZs from the subnets the module selects; there is no separate node
# count to set.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "reporter"
environment = "prd"

mode = "dedicated"

# If you switch to mode = "shared", shared_broker_name is MANDATORY here:
#   shared_broker_name = "shared-prd-rabbitmq-cluster"

# vpc_name         is derived -> lerian-prd-vpc   (infra-base/vpc)
# eks_cluster_name is derived -> lerian-prd-eks   (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Ports
#
# 5671 (AMQPS) and 443 (management HTTPS) are what AmazonMQ actually serves.
#
# Mind the mapping on the way out: this chart emits the AMQPS port as
# RABBITMQ_PORT_AMQP and the management port as RABBITMQ_PORT_HOST — the reverse
# of the midaz chart. See the header of outputs.tf.
#
# enable_console_ingress stays true: RABBITMQ_HEALTH_CHECK_URL targets the
# management API on 443, and the chart's bootstrap Job declares the exchange,
# queue and binding over that same API.
################################################################################

port                   = 5671
console_port           = 443
enable_console_ingress = true

################################################################################
# Broker — CLUSTER_MULTI_AZ on mq.m5.large
#
# apply_immediately is false in production: a broker modification applied outside
# the maintenance window is a reboot in the middle of a report run.
################################################################################

broker_deployment_mode   = "CLUSTER_MULTI_AZ"
append_deployment_suffix = true
host_instance_type       = "mq.m5.large"
engine_version           = "3.13"
mq_admin_user            = "rabbitmqadmin"

auto_minor_version_upgrade = true
apply_immediately          = false
enable_general_logs        = true

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
