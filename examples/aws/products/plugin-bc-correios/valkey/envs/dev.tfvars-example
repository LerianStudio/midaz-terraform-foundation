################################################################################
# products/plugin-bc-correios/valkey — dev
#
# Absolute minimum sizing. cache.t4g.micro with one cache cluster is roughly
# USD 12/month. plugin-bc-correios uses the cache for its BC Correio rate
# limit counters, so an empty cache means the plugin re-learns its budget.
#
# Copy to dev.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "plugin-bc-correios"
environment = "dev"

mode = "dedicated"

# vpc_name         is derived -> lerian-dev-vpc   (infra-base/vpc)
# eks_cluster_name is derived -> lerian-dev-eks   (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine and sizing — cache.t4g.micro, one cache cluster (~USD 12/month)
#
# One cache cluster means no failover and no Multi-AZ: both require at least two.
################################################################################

engine_version         = "7.2"
parameter_group_family = "valkey7"
port                   = 6379

node_type                  = "cache.t4g.micro"
num_cache_clusters         = 1
automatic_failover_enabled = false
multi_az_enabled           = false
snapshot_retention_limit   = 0

################################################################################
# Security
#
# transit_encryption_mode stays "preferred": this chart has no cache TLS key of
# any kind, so there is no way to tell the application to speak TLS and
# "required" would refuse every connection it makes.
#
# auth_token_enabled = false to start, but it is reachable: the chart DOES have a
# CACHE_PASSWORD key. Flip it once the ExternalSecret populating CACHE_PASSWORD
# from plugin-bc-correios-dev-valkey/auth-token is in place — the token is
# generated and stored either way.
################################################################################

transit_encryption_enabled = true
transit_encryption_mode    = "preferred"
auth_token_enabled         = false

maintenance_window = "mon:00:00-mon:03:00"

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-dev"
}
