################################################################################
# products/plugin-bc-correios/postgres — dev
#
# Absolute minimum sizing. Validating this stack in a real AWS account costs
# real money: db.t4g.micro with 20 GB is roughly USD 15/month.
#
# Copy to dev.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "plugin-bc-correios"
environment = "dev"

mode = "dedicated"

# vpc_name         is derived -> lerian-dev-vpc   (infra-base/vpc)
# eks_cluster_name is derived -> lerian-dev-eks   (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine
#
# engine_version stays MAJOR-only. Pinning "16.3" is what broke a real apply:
# AWS retired that minor and every plan afterwards failed with
# "Cannot find version 16.3 for postgres".
#
# NOTE ON THE MAJOR: the chart's bundled Bitnami subchart runs PostgreSQL 17.4,
# while this root provisions 16 — the repository-wide default that midaz and the
# shared tier also run. 16 is the conservative choice, not a verified
# requirement. CONFIRMAR with the application team whether plugin-bc-correios
# depends on anything that landed in 17; if it does, move engine_version, family
# and major_engine_version together.
#
# database_name and username are UNDERSCORED, not the chart's hyphenated
# defaults. RDS rejects hyphens in db_name and in the master username, and the
# root validates both. helm_values emits these values as POSTGRES_NAME and
# POSTGRES_USER so the chart follows RDS.
################################################################################

engine_version       = "16"
family               = "postgres16"
major_engine_version = "16"
database_name        = "bc_correios"
username             = "bc_correios"

################################################################################
# Sizing — db.t4g.micro (~USD 15/month)
#
# Performance Insights MUST stay false: AWS does not offer it on db.t4g.micro,
# and the module rejects the combination with a plan-time precondition rather
# than letting the apply fail five minutes in. Enhanced Monitoring is off for the
# same cost reason, and the monitoring IAM role goes with it.
#
# Watch the connection pool: the chart ships POSTGRES_MAX_CONNS = 50, and a
# db.t4g.micro does not have 50 connections to spare next to its own overhead.
# Lower it in the release values for dev.
################################################################################

instance_class        = "db.t4g.micro"
allocated_storage     = 20
max_allocated_storage = 50
multi_az              = false

backup_retention_period = 1
skip_final_snapshot     = true
deletion_protection     = false

performance_insights_enabled = false
monitoring_interval          = 0
create_monitoring_role       = false

enabled_cloudwatch_logs_exports = ["postgresql"]

create_read_replica = false

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-dev"
}
