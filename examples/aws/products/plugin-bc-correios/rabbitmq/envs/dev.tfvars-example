################################################################################
# products/plugin-bc-correios/rabbitmq — dev
#
# There is no cheap AmazonMQ RabbitMQ broker. The engine only accepts the
# mq.m5.* and mq.m7g.* families, so the floor is a SINGLE_INSTANCE
# mq.m7g.medium at roughly USD 100/month (us-east-1 on-demand, ESTIMATE).
# mq.t3.micro is an ActiveMQ-ONLY type and AmazonMQ refuses it for RabbitMQ
# in every deployment mode.
#
# For a dev environment that only needs the plugin to boot, mode = "shared"
# against products/shared-resources/rabbitmq avoids a second USD 100 broker.
#
# Copy to dev.tfvars before use (*.tfvars is gitignored, *.tfvars-example is not).
################################################################################

region      = "us-east-1"
product     = "plugin-bc-correios"
environment = "dev"

mode = "dedicated"

# If you switch to mode = "shared", also set shared_broker_name: the shared
# broker's name carries a -single / -cluster suffix the lookup cannot discover.
# For dev the derived default already matches ("shared-dev-rabbitmq-single").

# vpc_name         is derived -> lerian-dev-vpc   (infra-base/vpc)
# eks_cluster_name is derived -> lerian-dev-eks   (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# READ THIS BEFORE APPLYING
#
# The plugin-bc-correios chart cannot talk to an AmazonMQ broker today. Its init
# container waits on a HARDCODED port 5672:
#
#   wait_for_service "$RABBITMQ_HOST" "5672"        templates/deployment.yaml
#
# AmazonMQ for RabbitMQ serves AMQPS on 5671 only and publishes no plaintext
# listener, so that check times out after 300 seconds and the pod never starts.
# It needs a chart change — the literal has to become a configurable port.
#
# This stack is still correct and still worth applying (the broker, its security
# group and its secret are real, and the shape is right), but do not schedule the
# Helm cutover until the chart is fixed. Full detail in outputs.tf.
################################################################################

################################################################################
# Ports
#
# 5671 (AMQPS) and 443 (management HTTPS) are what AmazonMQ actually serves.
# Neither number reaches the chart: it has no RabbitMQ port variable at all. The
# port travels inside RABBITMQ_URL, which is a Secret because it embeds the
# password — see outputs.tf.
#
# enable_console_ingress stays true so global.externalRabbitmqDefinitions can run
# its bootstrap Job against the management API (set its connection.protocol to
# "https" and connection.port to 443 when pointing it at AmazonMQ).
################################################################################

port                   = 5671
console_port           = 443
enable_console_ingress = true

################################################################################
# Broker — SINGLE_INSTANCE on mq.m7g.medium
#
# engine_version is the AMAZONMQ-supported version, which is not the same list as
# upstream RabbitMQ. The chart's bundled subchart image is 4.0.5 — that is the
# in-cluster broker's version and has no bearing on AmazonMQ, which does not
# offer 4.x. Do not "align" the two.
################################################################################

broker_deployment_mode   = "SINGLE_INSTANCE"
append_deployment_suffix = true
host_instance_type       = "mq.m7g.medium"
engine_version           = "3.13"
mq_admin_user            = "rabbitmqadmin"

auto_minor_version_upgrade = true
apply_immediately          = true
enable_general_logs        = true

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-dev"
}
