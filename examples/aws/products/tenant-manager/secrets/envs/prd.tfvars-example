################################################################################
# products/tenant-manager/secrets — prd
#
# Costs nothing: one IAM role and one IAM policy.
#
# THE SCOPE HERE IS WIDER THAN EVERY OTHER ROLE ON THE ESTATE, deliberately, and
# the reason is in variables.tf: three measured path shapes (the production fork,
# the blank-env segment, and the one builder that keeps UUID dashes) make an
# environment-scoped prefix wrong in a way that only shows up as a 404 in the
# middle of provisioning a tenant. Narrow it after those shapes are fixed upstream,
# not before.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "sa-east-1"
product     = "tenant-manager"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Identity
#
# CONFIRM AGAINST THE CHART BEFORE THE FIRST APPLY. tenant-manager has no chart in
# its repository; the chart lives in the internal gitops repo, and the :sub
# condition admits this exact namespace:name and nothing else.
################################################################################

service_account = "platform:tenant-manager"

################################################################################
# Vault scope — the two roots, not an environment
################################################################################

secret_path_prefixes = [
  "tenants/",
  "clusters/",
]

read_actions = [
  "secretsmanager:GetSecretValue",
  "secretsmanager:DescribeSecret",
]

# It upserts, unlike the gateway. RestoreSecret is live: it soft-deletes with a 7
# day recovery window and resurrects on re-provision.
write_actions = [
  "secretsmanager:CreateSecret",
  "secretsmanager:PutSecretValue",
  "secretsmanager:RestoreSecret",
  "secretsmanager:DeleteSecret",
]

################################################################################
# The hole carved out of that wide Allow
#
# tenants/ above necessarily covers
# tenants/{env}/{org}/br-consignado-gw/external/{target}/credentials/versions/{uuid} —
# a tenant's Dataprev credential.
#
# The gateway pays real cost for that credential to be immutable: a variable
# validation refuses it PutSecretValue, so rotation writes a NEW version path and
# the audit trail cannot be rewritten. That property is worth nothing while the
# control plane next door holds PutSecretValue and DeleteSecret over the same ARNs.
# A Deny here makes the immutability an invariant of the ESTATE instead of a
# property of one role.
#
# tenant-manager never writes under {app}/external/ — it writes {module}/kafka,
# m2m/... and admin — so it loses no function.
################################################################################

deny_secret_path_patterns = ["tenants/*/*/*/external/"]

deny_actions = [
  "secretsmanager:CreateSecret",
  "secretsmanager:PutSecretValue",
  "secretsmanager:UpdateSecret",
  "secretsmanager:RestoreSecret",
  "secretsmanager:DeleteSecret",
]

# The readiness probe lists unscoped, so /readyz reports the vault down without it.
allow_list_secrets = true

################################################################################
# The bucket grant, attached here rather than to a role of its own
#
# products/tenant-manager/s3 runs with irsa_enabled = false and creates no role;
# it emits these policies for this role to borrow. A ServiceAccount carries exactly
# one role-arn annotation, so this is how the control plane holds both the vault
# and its buckets.
#
# APPLY THE s3 ROOT FIRST. An attachment to a policy that does not exist yet fails
# with NoSuchEntity — loud, not silent.
################################################################################

additional_policy_names = [
  "tenant-manager-prd-migrations-s3-access",
  "tenant-manager-prd-casdoor-templates-s3-access",
]

kms_key_arns = []

################################################################################
# Provisioning grants — EMPTY ON DAY ONE, AND THAT IS A DECISION
#
# tenant-manager instantiates CloudFormation, RDS, DocDB, EC2 and S3 clients with
# this same identity. Every one of those initialisers SOFT-FAILS: it logs a warning
# and disables the feature rather than refusing to boot. So the service comes up
# healthy with none of them, which is exactly what the fio mínimo wants — tenant
# onboarding needs the vault, Casdoor and the databases that already exist, not the
# power to create new ones.
#
# Turning any of these on is a real decision, because a CreateStack grant is
# effectively a grant of everything those templates create. Write it here, where it
# is reviewable, when the estate actually needs per-tenant provisioning.
#
# The shape, for when that day comes:
#
#   extra_policy_statements = [
#     {
#       sid       = "ReadOnlyNetworkDiscovery"
#       actions   = ["ec2:DescribeVpcs", "ec2:DescribeSubnets"]
#       resources = ["*"]
#     },
#     {
#       sid       = "MigrationArtifacts"
#       actions   = ["s3:GetObject", "s3:ListBucket"]
#       resources = [
#         "arn:aws:s3:::tenant-manager-prd-migrations-<ACCOUNT-ID>",
#         "arn:aws:s3:::tenant-manager-prd-migrations-<ACCOUNT-ID>/*",
#       ]
#     },
#   ]
#
# NOT included even in that sketch: kafka:*. MSK users and ACLs are created over
# the Kafka wire protocol with franz-go, so what tenant-manager needs there is
# network egress to the broker port — a security group, not a policy.
################################################################################

extra_policy_statements = []

extra_tags = {
  Owner      = "consignado"
  CostCenter = "consignado-prd"
}
