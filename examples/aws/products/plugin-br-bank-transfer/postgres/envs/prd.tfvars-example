################################################################################
# products/plugin-br-bank-transfer/postgres — prd
#
# Production: Multi-AZ, deletion protection on, and both observability paths
# enabled.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "plugin-br-bank-transfer"
environment = "prd"

mode = "dedicated"

# vpc_name         is derived -> lerian-prd-vpc        (infra-base/vpc)
# eks_cluster_name is derived -> lerian-prd-eks        (infra-base/eks)

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Engine
#
# engine_version stays MAJOR-only. Pinning "16.3" is what broke a real apply:
# AWS retired that minor and every plan afterwards failed with
# "Cannot find version 16.3 for postgres".
#
# database_name is the ONE logical database the plugin uses, emitted as
# POSTGRES_DB. Watch the chart key: this plugin says POSTGRES_DB where the
# notifications chart says POSTGRES_NAME and midaz says DB_ONBOARDING_NAME.
################################################################################

engine_version       = "16"
family               = "postgres16"
major_engine_version = "16"
database_name        = "bank_transfer"
username             = "bank_transfer"

################################################################################
# Sizing — db.m7g.large, Multi-AZ
################################################################################

instance_class        = "db.m7g.large"
allocated_storage     = 100
max_allocated_storage = 1000
multi_az              = true

backup_retention_period = 14
skip_final_snapshot     = false
deletion_protection     = true

performance_insights_enabled          = true
performance_insights_retention_period = 7
monitoring_interval                   = 60
create_monitoring_role                = true

enabled_cloudwatch_logs_exports = ["postgresql", "upgrade"]

################################################################################
# Read replica — the CQRS read path
#
# Created as plugin-br-bank-transfer-prd-postgres-replica and emitted by
# helm_values as POSTGRES_REPLICA_HOST / _PORT / _USER / _DB. The chart renders
# that whole block only when POSTGRES_REPLICA_HOST is present, so turning this
# off is how you tell the plugin there is no read pool — there is no "point the
# reads at the writer" middle state to fall into.
#
# POSTGRES_REPLICA_PASSWORD comes from secret_name through External Secrets: a
# read replica shares the master credentials of its source instance, so it is the
# same secret as POSTGRES_PASSWORD.
################################################################################

create_read_replica         = true
read_replica_instance_class = "db.m7g.large"
read_replica_multi_az       = false

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-prd"
}
