################################################################################
# products/streaming-hub/secrets — prd
#
# Costs nothing: one IAM role and one IAM policy.
#
# allow_list_secrets = true IS THE WHOLE POINT OF THIS FILE. The hub builds its
# tenant roster by LISTING the vault, and an empty listing makes it refuse to boot.
# Turn it off and the symptom is a crashloop complaining about tenants, not a
# permission error.
#
# Copy to prd.tfvars before use.
################################################################################

region      = "sa-east-1"
product     = "streaming-hub"
environment = "prd"

# eks_cluster_name is derived -> lerian-prd-eks

################################################################################
# Identity
#
# CONFIRM THIS AGAINST THE CHART BEFORE THE FIRST APPLY. streaming-hub has no chart
# yet, so the namespace and service account name below are the intended convention
# rather than a measured fact, and the :sub condition admits nothing else. If the
# chart ends up giving ingest and delivery separate service accounts, this root
# needs one instance per account — the roster is built at boot by BOTH.
################################################################################

service_account = "streaming:streaming-hub"

################################################################################
# Vault scope
#
# "production", not "prd": this is the application's ENV_NAME, and it is the same
# literal the hub uses to build the listing prefix. A mismatch here produces an
# empty roster, which the hub reports as a refusal to boot.
################################################################################

secret_path_prefixes = ["tenants/production/"]

# Values are read only for the hub's own M2M manifest credential. The tenant roster
# reads NAMES.
read_actions = [
  "secretsmanager:GetSecretValue",
  "secretsmanager:DescribeSecret",
]

# The hub writes nothing to the vault. Tenant Kafka sheets are tenant-manager's.
write_actions = []

# Not optional in multi-tenant mode. Necessarily account-wide: AWS does not scope
# ListSecrets to a resource, so the hub sees every secret NAME in the account and no
# value.
allow_list_secrets = true

kms_key_arns = []

extra_tags = {
  Owner      = "consignado"
  CostCenter = "consignado-prd"
}
