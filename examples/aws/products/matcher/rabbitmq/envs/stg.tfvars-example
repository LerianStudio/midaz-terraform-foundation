################################################################################
# products/matcher/rabbitmq — stg
#
# INFERRED DEPENDENCY — see dev.tfvars-example before applying this directory.
#
# CLUSTER_MULTI_AZ on mq.m5.large: the first topology that exercises a real
# cluster. Three broker nodes instead of dev's one.
#
# Copy to stg.tfvars before use.
################################################################################

region      = "us-east-1"
product     = "matcher"
environment = "stg"

mode = "dedicated"

# vpc_name         is derived -> lerian-stg-vpc        (infra-base/vpc)
# eks_cluster_name is derived -> lerian-stg-eks        (infra-base/eks)

# If you switch to mode = "shared", shared_broker_name is MANDATORY here. The
# products/shared-resources/rabbitmq stg tfvars deploy the shared broker as
# CLUSTER_MULTI_AZ, and the derived default assumes -single:
#   shared_broker_name = "shared-stg-rabbitmq-cluster"

################################################################################
# Ingress
################################################################################

allow_private_subnet_cidr_ingress      = true
eks_node_security_group_lookup_enabled = true
allow_vpc_cidr_ingress                 = false

allowed_security_group_ids = []
allowed_cidr_blocks        = []

################################################################################
# Ports
#
# 5671 (AMQPS) and 443 (management HTTPS) are what AmazonMQ actually serves.
#
# Neither is emitted into a helm_values map: there is no readable Matcher chart,
# so the env var names are unknown. Use the port, console_port, amqp_endpoint and
# console_url outputs to wire the release by hand.
################################################################################

port                   = 5671
console_port           = 443
enable_console_ingress = true

################################################################################
# Broker — CLUSTER_MULTI_AZ on mq.m5.large
#
# append_deployment_suffix stays true: it is what makes the SINGLE_INSTANCE ->
# CLUSTER_MULTI_AZ migration a side-by-side procedure (the -single and -cluster
# brokers coexist) rather than a destroy-and-recreate.
#
# apply_immediately is false from staging on: a broker modification applied
# outside the maintenance window is a reboot in the middle of the day.
################################################################################

broker_deployment_mode   = "CLUSTER_MULTI_AZ"
append_deployment_suffix = true
host_instance_type       = "mq.m5.large"
engine_version           = "3.13"
mq_admin_user            = "rabbitmqadmin"

auto_minor_version_upgrade = true
apply_immediately          = false
enable_general_logs        = true

extra_tags = {
  Owner      = "devops"
  CostCenter = "platform-stg"
}
